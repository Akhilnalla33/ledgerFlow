{
  "realm": "ledgerflow",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "USER", "description": "Can act on their own accounts" },
      { "name": "ADMIN", "description": "Can act on any account" }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@ledgerflow.local",
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ],
  "clients": [
    {
      "clientId": "ledgerflow-demo",
      "publicClient": true,
      "enabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": ["*"],
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}

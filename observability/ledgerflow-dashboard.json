{
  "title": "LedgerFlow Overview",
  "uid": "ledgerflow-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transfer request rate (account-service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"account-service\",uri=\"/api/v1/transfers\"}[1m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transfer latency p95/p99 (account-service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"account-service\",uri=\"/api/v1/transfers\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"account-service\",uri=\"/api/v1/transfers\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Optimistic lock conflicts / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"account-service\",status=\"409\"}[1m]))",
          "legendFormat": "409 conflicts/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox rows pending publish",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"account-service\"}",
          "legendFormat": "active DB connections (proxy signal for outbox activity)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Settlement saga outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"settlement-service\",uri=\"/api/v1/settlements\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap used (all services)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
